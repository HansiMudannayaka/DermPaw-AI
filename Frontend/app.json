{
  "expo": {
    "name": "DermPawAI",
    "slug": "DermPawAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dermpawai",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.DermPawAI",
      "softwareKeyboardLayoutMode": "resize"
    },

    "web": {
      "output": "single"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ]
  }
}