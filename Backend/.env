# Flask ML Service URL
# IMPORTANT: Use the LAN IP of this computer (not 127.0.0.1) if React Native
# runs on a physical phone, because 127.0.0.1 on the phone points to the phone
# itself - not to your development computer.
# Node.js -> Flask communication is always server-side so 127.0.0.1 is fine here.
FLASK_ML_URL=http://127.0.0.1:5000